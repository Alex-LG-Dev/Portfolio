<footer class="end" id="contacto" aria-labelledby="t-end">
  <div class="wrap">
    <h2 id="t-end">¿Construimos<br><span class="ink2" data-t="algo juntos?">algo juntos?</span></h2>
    <p>Busco prácticas y proyectos donde aprender mucho. Escríbeme y te contesto rápido.</p>
    <div class="end__act">
      <button type="button" class="btn btn--red" id="copy" data-email="hola@alex.example"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>Copiar mi email</button>
      <a class="btn btn--line" href="mailto:hola@alex.example">hola@alex.example</a>
      <a class="btn btn--line" href="https://github.com/Alex-LG-Dev" rel="noopener">GitHub</a>
    </div>
    <div class="end__foot"><span>Alex López Gea · Gandia, 2026</span><span>Impreso en rojo y morado</span></div>
  </div>
</footer>
<div class="toast" id="toast" role="status" aria-live="polite"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>Email copiado</span></div>

<script>
// copiar email
const toast = document.getElementById('toast')!;
const label = toast.querySelector('span')!;
let tt: number | undefined;
document.getElementById('copy')!.addEventListener('click', async (e) => {
  const m = (e.currentTarget as HTMLElement).dataset.email ?? '';
  try { await navigator.clipboard.writeText(m); label.textContent = 'Email copiado'; }
  catch { label.textContent = m; }
  toast.classList.add('is-on'); clearTimeout(tt); tt = window.setTimeout(() => toast.classList.remove('is-on'), 2400);
});
</script>
