---
// En las páginas de proyecto los enlaces vuelven a la portada
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const home = Astro.url.pathname.replace(/\/?$/, "/") === base ? "" : base;
---
<header class="top">
  <div class="wrap">
    <a class="mark" href={home || "#"}><span class="ink2" data-t="Alex-LG-Dev">Alex-LG-Dev</span></a>
    <nav class="nav" aria-label="Secciones"><a href={`${home}#ideas`}>Cómo pienso</a><a href={`${home}#proyectos`}>Proyectos</a><a href={`${home}#sobre-mi`}>Sobre mí</a></nav>
    <a class="btn btn--red" href="#contacto">Escríbeme</a>
  </div>
</header>
