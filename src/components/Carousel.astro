---
import type { Slide } from "../data/projects";
interface Props { slides: Slide[]; label: string }
const { slides, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<div class="print car" role="region" aria-roledescription="carrusel" aria-label={`Capturas de ${label}`}>
  <div class="car__view">
    <div class="car__track" tabindex="0" aria-label="Capturas, usa las flechas para pasar">
      {slides.map((s, i) => (
        <figure class="car__slide">
          <button type="button" class="car__zoom" data-i={i} aria-label={`Ver en grande: ${s.caption}`}>
            <img src={`${base}img/${s.src}`} alt={s.alt} loading="lazy" decoding="async" width="1200" height="760" />
          </button>
          <figcaption>{s.caption}</figcaption>
          <span class="car__hint" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg></span>
        </figure>
      ))}
    </div>
  </div>
  <div class="car__bar">
    <button type="button" class="car__btn" data-dir="-1" aria-label="Imagen anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
    <div class="car__dots">
      {slides.map((_, i) => (
        <button type="button" class="car__dot" aria-label={`Imagen ${i + 1} de ${slides.length}`} aria-current={i === 0 ? "true" : "false"} />
      ))}
    </div>
    <button type="button" class="car__btn" data-dir="1" aria-label="Imagen siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
  </div>

  <dialog class="lb" aria-label={`${label}: capturas en grande`}>
    <div class="lb__track">
      {slides.map((s) => (
        <figure class="lb__slide">
          <img src={`${base}img/${s.src}`} alt={s.alt} loading="lazy" decoding="async" width="1200" height="760" />
          <figcaption>{s.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="lb__bar">
      <button type="button" class="car__btn lb__btn" data-dir="-1" aria-label="Imagen anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
      <span class="lb__count mono" aria-live="polite"></span>
      <button type="button" class="car__btn lb__btn" data-dir="1" aria-label="Imagen siguiente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
    </div>
    <button type="button" class="car__btn lb__close" aria-label="Cerrar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
  </dialog>
</div>

<script>
const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
// carruseles
document.querySelectorAll<HTMLElement>('.car').forEach(c => {
  const t = c.querySelector<HTMLElement>('.car__track')!, d = [...c.querySelectorAll<HTMLButtonElement>('.car__dot')], n = d.length;
  const idx = () => Math.round(t.scrollLeft / t.clientWidth);
  const go = (i: number) => { i = (i + n) % n; t.scrollTo({ left: i * t.clientWidth, behavior: reduce() ? 'auto' : 'smooth' }); };
  c.querySelectorAll<HTMLButtonElement>('.car__bar .car__btn').forEach(b => b.addEventListener('click', () => go(idx() + Number(b.dataset.dir))));
  d.forEach((b, i) => b.addEventListener('click', () => go(i)));
  t.addEventListener('keydown', e => { if (e.key === 'ArrowRight') { e.preventDefault(); go(idx() + 1); } if (e.key === 'ArrowLeft') { e.preventDefault(); go(idx() - 1); } });
  let raf = 0; t.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(() => { const i = idx(); d.forEach((b, j) => b.setAttribute('aria-current', j === i ? 'true' : 'false')); }); }, { passive: true });
  // a color al pasar o enfocar
  const on = () => c.classList.add('is-color'), off = () => { if (!c.contains(document.activeElement)) c.classList.remove('is-color'); };
  c.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') on(); }); c.addEventListener('pointerleave', off);
  c.addEventListener('focusin', on); c.addEventListener('focusout', () => setTimeout(off));

  // en grande: al pulsar una captura se abre a pantalla completa y a color
  const dlg = c.querySelector<HTMLDialogElement>('.lb')!, lt = dlg.querySelector<HTMLElement>('.lb__track')!, cnt = dlg.querySelector<HTMLElement>('.lb__count')!;
  const li = () => Math.round(lt.scrollLeft / lt.clientWidth);
  const lgo = (i: number, smooth = true) => { i = (i + n) % n; lt.scrollTo({ left: i * lt.clientWidth, behavior: smooth && !reduce() ? 'smooth' : 'auto' }); };
  const count = () => { cnt.textContent = `${li() + 1} / ${n}`; };
  c.querySelectorAll<HTMLButtonElement>('.car__zoom').forEach(b => b.addEventListener('click', () => {
    dlg.showModal(); document.documentElement.classList.add('lb-open');
    requestAnimationFrame(() => { lgo(Number(b.dataset.i), false); count(); });
  }));
  dlg.querySelectorAll<HTMLButtonElement>('.lb__btn').forEach(b => b.addEventListener('click', () => lgo(li() + Number(b.dataset.dir))));
  dlg.querySelector('.lb__close')!.addEventListener('click', () => dlg.close());
  // pulsar fuera de la imagen también cierra
  dlg.addEventListener('click', e => { if (e.target === dlg || (e.target as HTMLElement).classList.contains('lb__slide')) dlg.close(); });
  dlg.addEventListener('keydown', e => { if (e.key === 'ArrowRight') { e.preventDefault(); lgo(li() + 1); } if (e.key === 'ArrowLeft') { e.preventDefault(); lgo(li() - 1); } });
  dlg.addEventListener('close', () => { document.documentElement.classList.remove('lb-open'); go(li()); });
  let r2 = 0; lt.addEventListener('scroll', () => { cancelAnimationFrame(r2); r2 = requestAnimationFrame(count); }, { passive: true });
});
</script>
